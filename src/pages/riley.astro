<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f8f7f2" />
  <title>Riley · Little moments</title>
  <link rel="stylesheet" href="/riley/style.css" />
  <script src="../scripts/riley.js"></script>
</head>
<body>
  <div class="demo-bar" id="app-status"><span class="demo-dot"></span><span id="app-status-text">Loading Riley…</span></div>
  <section class="auth-panel" id="sign-in-panel" aria-labelledby="sign-in-title" hidden>
    <p class="eyebrow">A LITTLE MOMENT</p>
    <h1 id="sign-in-title">Welcome back<span class="brand-dot">.</span></h1>
    <p class="subtitle">Sign in with your email and password. This browser will stay signed in.</p>
    <form id="sign-in-form">
      <label for="auth-email">Email address</label>
      <input id="auth-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
      <label for="auth-password">Password</label>
      <input id="auth-password" name="password" type="password" autocomplete="current-password" required />
      <button class="primary-button" id="sign-in-submit" type="submit">Sign in <span aria-hidden="true">↗</span></button>
      <button class="text-button" id="reset-password" type="button">Set or reset password</button>
      <button class="text-button" id="email-link-sign-in" type="button">Email me a sign-in link</button>
    </form>
    <p class="form-hint" id="auth-message" role="status" aria-live="polite">Use the email address assigned to your Riley account.</p>
    <div class="access-pending" id="access-pending" hidden>
      <strong>This account hasn’t been added to Riley yet.</strong>
      <span>Share this account ID with the household owner to finish setup.</span>
      <code id="auth-uid"></code>
      <button class="secondary-button" type="button" id="copy-auth-uid">Copy account ID</button>
    </div>
  </section>
  <div class="shell" id="tracker-app" hidden>
    <header class="masthead">
      <a class="brand" href="/riley" aria-label="Riley home"><span class="flower" aria-hidden="true">✳</span> riley<span class="brand-dot">.</span></a>
      <span class="masthead-note">A little record of the everyday.</span>
      <div class="account-controls" id="account-controls" hidden><span id="account-name"></span><button class="text-button" id="sign-out" type="button">Sign out</button></div>
      <button class="text-button" id="reset-demo" type="button" hidden>Reset demo <span aria-hidden="true">↻</span></button>
    </header>
    <main>
      <section class="intro">
        <div><p class="eyebrow">LITTLE MOMENTS, ALL TOGETHER</p><h1>Riley’s day<span class="brand-dot">.</span></h1><p class="subtitle">One less thing to keep in your head.</p></div>
        <div class="date-nav"><button id="previous-day" class="icon-button" aria-label="Previous day">←</button><div><strong id="day-label">Today</strong><span id="date-label"></span></div><button id="next-day" class="icon-button" aria-label="Next day">→</button></div>
      </section>
      <section aria-labelledby="quick-title" class="quick-section">
        <div class="section-caption"><h2 id="quick-title">Record a moment</h2><span>Pick an event. Add the details.</span></div>
        <div class="quick-grid">
          <button class="quick-card feed" data-add="feed"><span class="event-icon" aria-hidden="true">♡</span><span><strong>Feed</strong><small>Breast or bottle</small></span><span class="plus" aria-hidden="true">+</span></button>
          <button class="quick-card wee" data-add="diaper"><span class="event-icon droplet" aria-hidden="true"></span><span><strong>Diaper</strong><small>Wee, poo, or both</small></span><span class="plus" aria-hidden="true">+</span></button>
          <button class="quick-card sleep" id="sleep-action-card" data-add="sleep"><span class="event-icon" aria-hidden="true">☾</span><span><strong id="sleep-action-title">Sleep</strong><small id="sleep-action-hint">Start or log sleep</small></span><span class="plus" aria-hidden="true">+</span></button>
        </div>
      </section>
      <div class="main-grid">
        <section class="journal" aria-labelledby="timeline-title">
          <div class="journal-heading"><div><p class="eyebrow">THE LITTLE DETAILS</p><h2 id="timeline-title">Today’s timeline</h2></div><span class="count-pill" id="event-count"></span></div>
          <div class="filters" role="group" aria-label="Filter timeline"><button class="active" data-filter="all" aria-pressed="true">Everything</button><button data-filter="feed" aria-pressed="false">Feeds</button><button data-filter="wee" aria-pressed="false">Wees</button><button data-filter="poo" aria-pressed="false">Poos</button><button data-filter="sleep" aria-pressed="false">Sleep</button></div>
          <ol id="timeline" class="timeline"></ol>
          <div id="empty" class="empty" hidden><span aria-hidden="true">✳</span><h3>A little space for the day.</h3><p>No matching moments yet. Add one above.</p></div>
          <p class="timeline-foot">Tap any moment to edit its details.</p>
        </section>
        <aside>
          <section class="summary-card" aria-labelledby="summary-title"><div class="summary-top"><h2 id="summary-title">At a glance</h2><span aria-hidden="true">☀</span></div><p class="summary-subtitle" id="summary-period">Today so far</p><div id="summary"></div><div class="last-feed"><span>Last feed this day</span><strong id="last-feed">—</strong></div></section>
          <section class="note-card"><span class="note-flower" aria-hidden="true">✳</span><p>Small moments.<br />A clearer picture.</p><span>For the “when was the last…?”<br />and the middle-of-the-night handovers.</span></section>
        </aside>
      </div>
      <footer><span>Made for your little team <span aria-hidden="true">♡</span></span><span id="storage-note">Design preview · no shared storage yet</span></footer>
    </main>
  </div>
  <dialog id="entry-dialog" aria-labelledby="dialog-title">
      <div class="dialog-heading"><div><p class="eyebrow">A LITTLE MOMENT</p><h2 id="dialog-title">Record a feed</h2></div><button type="button" class="icon-button" id="close-dialog" aria-label="Close">×</button></div>
      <div id="entry-wizard" hidden>
        <p class="wizard-progress" id="wizard-progress"></p><div id="wizard-content"></div>
        <div class="dialog-actions"><button type="button" id="wizard-cancel" class="secondary-button">Cancel</button><button type="button" id="wizard-back" class="secondary-button">Back</button><button type="button" id="wizard-next" class="primary-button">Next <span aria-hidden="true">↗</span></button></div>
      </div>
      <form id="entry-form" hidden>
        <input type="hidden" id="entry-id" />
        <label>What happened?<select id="entry-type"><option value="feed">Feed</option><option value="wee">Wee</option><option value="poo">Poo</option><option value="both">Wee + poo</option><option value="sleep">Sleep</option></select></label>
        <div id="feed-fields"><label>Feed type<select id="feed-method"><option value="breast">Breast</option><option value="bottle">Bottle</option></select></label><div class="field-pair" id="breast-fields"><label>Started on<select id="feed-started"><option value="">Not recorded</option><option>Left</option><option>Right</option></select></label><label id="feed-legacy-label" hidden>Previous total minutes<input id="feed-legacy-duration" type="number" min="1" max="300" step="1" inputmode="numeric" /></label></div><div class="field-pair"><label>Left minutes (optional)<input id="feed-left-minutes" type="number" min="1" max="300" step="1" inputmode="numeric" /></label><label>Right minutes (optional)<input id="feed-right-minutes" type="number" min="1" max="300" step="1" inputmode="numeric" /></label></div><label id="bottle-fields" hidden>Amount in ml (optional)<input id="feed-amount" type="number" min="1" max="2000" step="1" inputmode="numeric" /></label></div>
        <div id="diaper-fields"><label id="wet-size-label">Wee amount<select id="wet-size"><option value="">Not recorded</option><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select></label><label id="stool-size-label">Poo amount<select id="stool-size"><option value="">Not recorded</option><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select></label></div>
        <label>When?<input id="entry-time" type="datetime-local" required /></label>
        <label id="sleep-end-label" hidden>Woke up at (leave blank if still asleep)<input id="sleep-end-time" type="datetime-local" /></label>
        <label>Caregiver<select id="entry-person"></select></label>
        <label>A note (optional)<textarea id="entry-note" rows="2" maxlength="300" placeholder="Anything you’d like to remember"></textarea></label>
        <p class="form-hint" id="entry-hint">Shared with your household as soon as you save.</p>
        <div class="dialog-actions"><button type="button" id="delete-entry" class="delete-button" hidden>Delete</button><button type="button" id="cancel-dialog" class="secondary-button">Cancel</button><button type="submit" class="primary-button">Save moment <span aria-hidden="true">↗</span></button></div>
      </form>
  </dialog>
  <div class="toast" id="toast" role="status" hidden><span id="toast-text"></span><button id="undo" hidden>Undo</button></div>
  <noscript>This interactive proposal needs JavaScript enabled. No real records are stored.</noscript>
</body>
</html>
