rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRileyMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/households/riley/members/$(request.auth.uid));
    }

    function validEvent(data) {
      return data.keys().hasOnly([
          'type', 'time', 'endTime', 'person', 'note', 'method', 'side', 'startedSide',
          'duration', 'leftMinutes', 'rightMinutes', 'amount', 'wetSize', 'stoolSize',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['type', 'time', 'person', 'note', 'createdBy', 'createdAt', 'updatedAt'])
        && data.type in ['feed', 'wee', 'poo', 'both', 'sleep']
        && data.time is timestamp
        && (!('endTime' in data) || data.endTime == null || data.endTime is timestamp)
        && data.person is string
        && data.person.size() <= 80
        && data.note is string
        && data.note.size() <= 300
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('method' in data) || data.method in ['breast', 'bottle'])
        && (!('side' in data) || data.side in ['', 'Left', 'Right', 'Both'])
        && (!('startedSide' in data) || data.startedSide in ['', 'Left', 'Right'])
        && (!('duration' in data) || data.duration is string || data.duration is int || data.duration is float)
        && (!('leftMinutes' in data) || ((data.leftMinutes is int || data.leftMinutes is float) && data.leftMinutes >= 1 && data.leftMinutes <= 300))
        && (!('rightMinutes' in data) || ((data.rightMinutes is int || data.rightMinutes is float) && data.rightMinutes >= 1 && data.rightMinutes <= 300))
        && (!('amount' in data) || data.amount is string || data.amount is int || data.amount is float)
        && (!('wetSize' in data) || data.wetSize in ['small', 'medium', 'large'])
        && (!('stoolSize' in data) || data.stoolSize in ['small', 'medium', 'large']);
    }

    match /households/riley/members/{uid} {
      // A signed-in user can check their own membership document, including when it is absent.
      allow get: if (signedIn() && request.auth.uid == uid) || isRileyMember();
      allow list: if isRileyMember();
      // Household membership is managed by the owner in the Firebase Console for this first version.
      allow create, update, delete: if false;
    }

    match /households/riley/events/{eventId} {
      allow read: if isRileyMember();
      allow create: if isRileyMember()
        && validEvent(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isRileyMember()
        && validEvent(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isRileyMember();
    }

    function gamePath(gameId) {
      return /databases/$(database)/documents/jeopardyGames/$(gameId);
    }

    function gameExists(gameId) {
      return exists(gamePath(gameId));
    }

    function gameHost(gameId) {
      return signedIn() && gameExists(gameId)
        && get(gamePath(gameId)).data.hostUid == request.auth.uid;
    }

    function gamePlayer(gameId) {
      return signedIn() && gameExists(gameId)
        && exists(/databases/$(database)/documents/jeopardyGames/$(gameId)/players/$(request.auth.uid));
    }

    match /jeopardyDecks/{deckId} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'name', 'rounds', 'final', 'categories', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['owner', 'name', 'rounds', 'final', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow get, list: if signedIn() && resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    match /jeopardyGames/{gameId} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.phase == 'lobby'
        && request.resource.data.keys().hasOnly([
          'hostUid', 'deckId', 'name', 'phase', 'roundIndex', 'categories', 'values', 'completed', 'current',
          'buzzedBy', 'buzzAt', 'activePlayer', 'finalCategory', 'createdAt', 'updatedAt'
        ]);
      allow get: if signedIn() && (resource.data.hostUid == request.auth.uid
        || resource.data.phase == 'lobby' || gamePlayer(gameId));
      allow list: if false;
      allow update: if gameHost(gameId)
        || (gamePlayer(gameId)
          && resource.data.phase == 'clue'
          && resource.data.buzzedBy == null
          && (resource.data.current.dailyDouble != true || resource.data.activePlayer == request.auth.uid)
          && request.resource.data.buzzedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buzzedBy', 'buzzAt', 'updatedAt']));
      allow delete: if gameHost(gameId);

      match /players/{playerId} {
        allow get, list: if gameHost(gameId) || gamePlayer(gameId);
        allow create: if signedIn() && playerId == request.auth.uid
          && gameExists(gameId) && get(gamePath(gameId)).data.phase == 'lobby'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && request.resource.data.score == 0
          && request.resource.data.keys().hasOnly(['name', 'score', 'joinedAt', 'isHost']);
        allow update: if gameHost(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score']);
        allow delete: if gameHost(gameId);
      }

      match /private/{answerDoc} {
        allow read, write: if gameHost(gameId);
      }

      match /responses/{playerId} {
        allow get: if gameHost(gameId) || (gamePlayer(gameId) && playerId == request.auth.uid);
        allow list: if gameHost(gameId);
        allow create: if gamePlayer(gameId) && playerId == request.auth.uid
          && get(gamePath(gameId)).data.phase == 'final'
          && request.resource.data.wager is number
          && request.resource.data.wager >= 0
          && request.resource.data.answer is string
          && request.resource.data.answer.size() <= 300
          && request.resource.data.keys().hasOnly(['wager', 'answer', 'submittedAt']);
        allow update, delete: if gameHost(gameId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
